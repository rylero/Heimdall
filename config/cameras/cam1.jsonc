{
  "id": 0,
  "type": "usb",
  // Prefer a stable by-id path over /dev/videoN — enumeration order can swap after a
  // brownout/re-plug (§2D). Find it with `ls -l /dev/v4l/by-id/` and use e.g.
  // "/dev/v4l/by-id/usb-<vendor>_<model>_<serial>-video-index0".
  "device": "/dev/video0",
  "width": 640,
  "height": 480,
  "fps": 60,
  "hw_decode": false,
  // Optional v4l2src knobs (defaults shown). pixel_format is the source caps media type:
  // "image/jpeg" (MJPEG, decoded) or a raw type like "video/x-raw,format=YUY2" (no decoder).
  // io_mode: 2=MMAP (default), 4=userptr, 1=RW — try another if a camera misbehaves on MMAP.
  // "pixel_format": "image/jpeg",
  // "io_mode": 2,
  "mirror_of": -1,
  // Camera is mounted upside-down; rotate 180° before nvinfer. Only 0/90/180/270 allowed.
  "rotation": 180,
  // nvinfer network input dims (must match infer-dims in config/infer_yolo*.txt). Detections
  // arrive letterboxed into this size; projection undoes the letterbox to native pixels.
  "infer_width": 640,
  "infer_height": 640,
  "intrinsics": {
    "fx": 541.8765,
    "fy": 542.0541,
    "cx": 364.3580,
    "cy": 200.9934,
    "distortion": { "k1": 0.026441, "k2": -0.040244, "p1": -0.000224, "p2": 0.003295, "k3": 0.011067 }
  },
  "extrinsics": {
    "tx": 0.0,
    "ty": 0.0889,
    "tz": 0.5207,
    "yaw": 0.4363,
    "pitch": 0.5061,
    "roll": 0.0
  }
}
