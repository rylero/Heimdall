{
  "id": 2,
  "type": "usb",
  "device": "/dev/video2",  // repurposed from the (removed) AprilTag camera
  "width": 640,
  "height": 480,
  "fps": 60,
  "hw_decode": false,
  // Real second camera on its own device — NOT a pipeline tee-mirror (that would tap cam1's
  // stream and ignore the device). "Mirror of cam1" here = cloned config.
  "mirror_of": -1,
  // Cloned from cam1: sensor mounted upside-down, rotate 180° before nvinfer.
  "rotation": 180,
  // nvinfer network input dims (must match infer-dims in config/infer_yolo*.txt).
  "infer_width": 640,
  "infer_height": 640,
  // Old cam2 intrinsics (pre-removal), per request. NOTE: these were calibrated for the old
  // /dev/video4 camera at 640x480 — if video2 is a different sensor, recalibrate.
  "intrinsics": {
    "fx": 544.3636,
    "fy": 545.4340,
    "cx": 364.6463,
    "cy": 202.9345,
    "distortion": { "k1": 0.038851, "k2": -0.024808, "p1": -0.002037, "p2": 0.001136, "k3": -0.050184 }
  },
  // Mirrors cam1's extrinsics, including roll=π for the upside-down sensor. A physically
  // separate camera at a different mount will need its own tx/ty/yaw/pitch — measure & update.
  "extrinsics": {
    "tx": 0.33,
    "ty": 0.0889,
    "tz": 0.762,
    "yaw": 0.4363,
    "pitch": 0.5061,
    "roll": 3.14159
  }
}
