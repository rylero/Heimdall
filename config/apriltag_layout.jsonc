{
  // Physical side length of each AprilTag square in metres.
  // 2025 FRC official: 0.1651 m (6.5 in).  Measure your actual printed tags.
  "tag_size_meters": 0.1651,

  // When true, always use the unconstrained IPPE_SQUARE solver instead of the
  // gyro/odometry-constrained solve, even after yaw self-calibration locks in.
  // Use this to debug pose accuracy independent of the robot's heading feed,
  // or if that feed is not trustworthy enough to seed the constrained solve.
  "force_unconstrained_solver": false,

  // ── Detector + pose-solve tuning ─────────────────────────────────────────
  // Previously hardcoded; exposed here so they can be tuned per venue without a
  // recompile. Omit the whole block to accept the defaults shown.
  "solver": {
    // Input downsample before tag detection. Higher = faster but shorter detection
    // range (2.0 halves resolution). Lower to 1.0 to detect smaller/farther tags at
    // a CPU cost. The #1 knob to tune for a venue's tag distances.
    "quad_decimate": 2.0,
    // Gaussian blur (sigma) applied before detection; 0 = off. Raise slightly on
    // noisy/low-light images to reduce false quads.
    "quad_sigma": 0.0,
    // Detector worker threads.
    "nthreads": 2,
    // Sub-pixel corner refinement (improves pose accuracy; small CPU cost).
    "refine_edges": true,
    // Reject an IPPE solve when its error ratio (best/second) exceeds this — the
    // two solutions are too similar to trust. 0.25 ≈ second solution within 4x.
    "ambiguity_max": 0.25,
    // Above this ratio, disambiguate the two IPPE solutions by picking the one whose
    // robot origin sits on the floor (z≈0) instead of always taking solution 0.
    "floor_disambiguation_min": 0.15
  },

  // ── AprilTag camera ──────────────────────────────────────────────────────
  // This is a SEPARATE USB camera from the two object-detection cameras.
  // It must be forward/wall-facing so it can see AprilTags.
  // Intrinsics come from calibrate_apriltag_camera.py.
  "camera": {
    "device": "/dev/video2",  // OV9281 monochrome — forward-facing apriltag camera
    "width":  1280,
    "height": 720,
    "fps":    100,

    // Intrinsics from video2 calibration (OV9281, 1280x720)
    "fx": 1077.5700702611311,
    "fy": 1077.5864218873826,
    "cx": 605.6919950680431,
    "cy": 398.46663494944875,

    // Radial/tangential distortion from calibration
    "k1": -0.4475926117829959,
    "k2":  0.2977503937949428,
    "p1": -0.0017858628691716629,
    "p2":  0.0019180370509349226,
    "k3": -0.14288879446427022
  },

  // ── Robot-to-camera transform ────────────────────────────────────────────
  // Position and orientation of the AprilTag camera relative to the robot's
  // centre of rotation (the origin of the robot coordinate frame).
  // Axes: +X = forward, +Y = left, +Z = up.
  //
  //   x, y, z  — camera optical centre position in metres
  //   roll     — rotation around X axis (radians); 0 for upright camera
  //   pitch    — rotation around Y axis (radians); negative tilts the camera down
  //   yaw      — rotation around Z axis (radians); 0 = camera faces robot-forward
  //
  // Measurement tip: put a tape measure on the robot frame.
  // x: distance from robot centre to camera along robot-forward
  // y: distance left (positive) or right (negative) of robot centre
  // z: height above ground
  "robot_to_camera": {
    "x":     0.4064,  // 16 in forward
    "y":     0.00,
    "z":     0.5779,  // 22.75 in up
    "roll":  0.0,
    "pitch": 0.0,     // 0 = pointing straight forward
    "yaw":   0.0
  },

  // ── Field AprilTag poses ─────────────────────────────────────────────────
  // One entry per tag visible from your field / arena.
  // Get official FRC field tag positions from:
  //   https://github.com/wpilibsuite/allwpilib/tree/main/apriltag/src/main/native/resources/edu/wpi/first/apriltag
  // Download the JSON for your game year, then extract each tag's
  // translation (x, y, z metres) and rotation.
  //
  // For FRC tag poses, rotation is given as a quaternion.
  // Convert quaternion (w,x,y,z) to yaw with:
  //   yaw = atan2(2*(w*z + x*y), 1 - 2*(y*y + z*z))
  // roll and pitch are 0 for wall-mounted tags (facing horizontally).
  //
  // x, y: tag centre position on the field in metres (origin = blue alliance
  //       wall corner per WPILib convention).
  // z:    height of tag centre above the floor in metres.
  // yaw:  which direction the tag faces (0 = facing +X / toward red alliance).
  "tags": [
    {
      "id":    21,
      "x":     0.0,
      "y":     0.0,
      "z":     0.6985,
      "roll":  0.0,
      "pitch": 0.0,
      "yaw":   0.0
    }
  ]
}
