{
  // Directory containing per-camera JSON files (one file per camera, sorted by name).
  "cameras_dir": "config/cameras",

  // Path to the DeepStream/TensorRT inference config (nvinfer plugin config file).
  "infer_config": "config/infer_yolo26n.txt",

  // JPDAF tracker parameters.
  "tracker": {
    // Frames a new track must be confirmed by a detection before being reported.
    "confirmation_frames": 2,

    // Frames without a matching detection before a track is declared LOST.
    "loss_frames": 15,

    // Euclidean pre-gate (meters): a cheap distance reject applied before the Mahalanobis
    // test. Detections beyond this from a track's predicted position skip that track.
    // NOTE: this is NOT the statistical gate — see mahalanobis_gate below.
    // MUST be smaller than the spacing between distinct objects, otherwise every detection
    // gates with every track: all tracks collapse to the weighted centroid, the densest
    // cluster (e.g. a fuel seen by two cameras) outvotes and abandons sparser objects, and the
    // abandoned object respawns a new track every frame → unbounded track growth. Size it as
    // max per-frame object displacement + measurement jitter (~0.4 m here), well under the
    // closest real object spacing.
    "gate_distance": 0.75,

    // Statistical (Mahalanobis, chi-square 2-DOF) gate. Detections beyond this distance
    // from a track — in covariance-normalized units — are statistically incompatible and
    // become new-object candidates instead of updates. 9.21 ≈ 99% confidence; raise to
    // absorb more, lower to spawn tracks more readily in high-clutter venues.
    "mahalanobis_gate": 9.21,

    // Duplicate-suppression radius (METERS, Euclidean). An unclaimed detection within this
    // distance of an existing track is treated as the SAME object seen again (most often a
    // second overlapping camera projecting to the same field xy) and is absorbed instead of
    // spawning a new track. Without this, coincident multi-camera detections spawn a fresh
    // track every frame that never dies → unbounded track growth. Detections beyond this still
    // spawn, so two genuinely distinct objects sharing one gate still split. Raise if two
    // cameras disagree by more than this (loose calibration); lower to split closer objects.
    // 0 = disabled.
    "dup_spawn_radius": 0.3,

    // Expected density of false-positive (clutter) detections per m².
    // Higher = tracker is less eager to create new tracks on single detections.
    "clutter_density": 1.0,

    // Probability that a real object generates a detection each frame.
    "p_detection": 0.9,

    // Kalman filter motion model.
    // Options: "constant_position", "constant_velocity", "constant_acceleration"
    "filter_model": "constant_velocity",

    // Kalman filter tuning.
    // meas_noise_r: measurement noise variance (m^2). Raise if tracks chase sensor noise;
    //   lower if tracks lag behind fast-moving objects. 0.4m jitter → 0.4^2 = 0.16.
    "meas_noise_r": 0.16,
    // process_noise_q: process noise intensity. Higher = tracks respond faster to
    //   acceleration; lower = smoother tracks that lag more during fast maneuvers.
    "process_noise_q": 2.0,
    // pos_cov_floor: minimum position covariance diagonal. Prevents Kalman gain from
    //   collapsing on long tracks (floor=0.1 → K >= 0.1/(0.1+0.16) ≈ 38% meas weight).
    "pos_cov_floor": 0.1
  },

  // ZeroMQ bind addresses (all on the Jetson side).
  "comm": {
    "pose_bind_addr":        "tcp://*:5555",  // PULL — robot pose in
    "output_bind_addr":      "tcp://*:5556",  // PUB  — track events out
    "apriltag_pose_bind_addr": "tcp://*:5558"  // PUB  — AprilTag pose estimate
  },

  // Set true to skip the tracker and forward raw detections directly.
  "bypass_tracker": false,

  // CSV tracker debug log (one row per update cycle).
  "log_tracking": true,
  "log_path": "logs/tracker_log.csv"

  // AprilTag disabled: /dev/video2 is now cam2 (YOLO detection), not the AprilTag camera.
  // To re-enable, restore video2 to the AprilTag cam and add back:
  //   , "apriltag_layout": "config/apriltag_layout.jsonc"
}
