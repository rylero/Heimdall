[Unit]
Description=Heimdall FRC vision stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust to wherever the repo lives on the Jetson (must contain docker/docker-compose.yml).
WorkingDirectory=/home/nvidia/Heimdall/docker
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# Give image pulls/builds unlimited time on a cold boot.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
